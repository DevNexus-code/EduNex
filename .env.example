# ==============================================================================
# NEXDESK - Environment Configuration Template
# Copy this file to '.env' in local development. Never commit '.env' to git.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
# Optional: Frontend API Base URL for direct LAN access (e.g. http://192.168.1.22:5000/api/v1).
# If omitted or left blank, the frontend uses relative '/api/v1' with Vite dev proxy automatically.
VITE_API_URL=

# ------------------------------------------------------------------------------
# Database Connections (PostgreSQL via Supabase or Local Docker)
# ------------------------------------------------------------------------------
# 1. DATABASE_URL:
#    - For Supabase (Production / Cloud Dev): Use the Transaction Mode Pooler (Port 6543)
#      e.g. "postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#    - For Local Docker PostgreSQL:
#      e.g. "postgresql://nexdesk_user:nexdesk_dev_password@localhost:5432/nexdesk_dev?schema=public"
DATABASE_URL="postgresql://nexdesk_user:nexdesk_dev_password@localhost:5432/nexdesk_dev?schema=public"

# 2. DIRECT_URL:
#    - For Supabase: Use Direct Connection (Port 5432) for running Prisma migrations
#      e.g. "postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"
#    - For Local Docker: Same as DATABASE_URL
DIRECT_URL="postgresql://nexdesk_user:nexdesk_dev_password@localhost:5432/nexdesk_dev?schema=public"

# ------------------------------------------------------------------------------
# Session & Authentication Security
# ------------------------------------------------------------------------------
# Generate a secure 64-char random string in production (e.g. openssl rand -hex 32)
SESSION_SECRET="dev_insecure_session_secret_replace_in_production_min_32_chars"
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Logging & Diagnostic Telemetry
# ------------------------------------------------------------------------------
# Options: fatal, error, warn, info, debug, trace
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Google OAuth & Supabase Client Integration
# ------------------------------------------------------------------------------
# Frontend Supabase URL & Public Anon Key
VITE_SUPABASE_URL="https://txvvfvztdqjhkfbtlbfg.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Optional: Designate initial Google account to be provisioned as ADMIN
# (All other Google registrations automatically default to EMPLOYEE)
BOOTSTRAP_ADMIN_EMAIL="admin@yourcompany.com"

# ------------------------------------------------------------------------------
# Email Automation & SMTP Notification Service
# ------------------------------------------------------------------------------
# Leave SMTP_HOST blank or unset to run in local development mode (in-memory devMailbox).
# For production (SendGrid, Mailgun, AWS SES, Resend, or standard SMTP):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="EDUNEX Academic Platform <noreply@edunex.edu>"

# Application Base URL for activation and password-setup links
APP_URL="http://localhost:5173"

