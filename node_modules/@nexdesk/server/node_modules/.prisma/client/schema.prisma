generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==============================================================================
// CORE USER & ROLE ENUMS
// ==============================================================================

enum Role {
  EMPLOYEE
  IT_AGENT
  TEAM_LEAD
  ADMIN
}

// ==============================================================================
// SDLC ORCHESTRATOR ENUMS
// ==============================================================================

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  PAUSED
}

enum PipelineStatus {
  PENDING
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum StageName {
  REQUIREMENTS_ANALYSIS
  ARCHITECTURE_DESIGN
  DEVELOPMENT
  CODE_REVIEW
  SECURITY_ANALYSIS
  BUILD_DEPLOYMENT
  AUTOMATED_TESTING
  DEFECT_MONITORING
}

enum StageStatus {
  PENDING
  RUNNING
  WAITING_APPROVAL
  PASSED
  FAILED
  BLOCKED
  SKIPPED
}

enum AgentRole {
  REQUIREMENTS_AGENT
  ARCHITECTURE_AGENT
  DEVELOPMENT_ASSISTANT
  CODE_REVIEW_AGENT
  SECURITY_AGENT
  BUILD_AGENT
  TESTING_AGENT
  DEFECT_ANALYSIS_AGENT
  MONITORING_AGENT
}

enum ApprovalGateType {
  ARCHITECTURE_APPROVAL
  CODE_MERGE_APPROVAL
  PRODUCTION_RELEASE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EnvironmentType {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum SeverityLevel {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ==============================================================================
// LEGACY ITSM ENUMS (Retained for backwards compatibility)
// ==============================================================================

enum TicketCategory {
  HARDWARE
  SOFTWARE
  NETWORK
  ACCESS
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  PENDING_USER
  RESOLVED
  CLOSED
}

enum AssetCategory {
  LAPTOP
  DESKTOP
  MONITOR
  PHONE
  PERIPHERAL
  SERVER
  NETWORK_EQUIPMENT
  OTHER
}

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  IN_REPAIR
  RETIRED
  LOST
}

enum LicenseType {
  PERPETUAL
  SUBSCRIPTION
  SEAT_BASED
}

// ==============================================================================
// USER & IDENTITY MODELS
// ==============================================================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String?   @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  role         Role      @default(EMPLOYEE)
  firebaseUid  String?   @unique @map("firebase_uid")
  googleId     String?   @unique @map("google_id")
  avatarUrl    String?   @map("avatar_url")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  departmentId String?   @map("department_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  department         Department?  @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepartments Department[] @relation("DepartmentManager")
  sessions           Session[]
  auditLogs          AuditLog[]

  // SDLC Orchestration Relations
  ownedProjects      Project[]       @relation("ProjectOwner")
  triggeredPipelines PipelineRun[]   @relation("PipelineTriggerer")
  stageApprovals     StageApproval[] @relation("ApprovalReviewer")
  assignedTasks      TaskItem[]      @relation("TaskAssignee")

  // Legacy ITSM Relations
  createdTickets      Ticket[]                 @relation("TicketCreator")
  assignedTickets     Ticket[]                 @relation("TicketAssignee")
  ticketComments      TicketComment[]
  ticketHistories     TicketHistory[]
  assignedAssets      Asset[]                  @relation("UserAssignedAssets")
  assetCustodyHistory AssetAssignmentHistory[] @relation("AssetCustodian")
  assetIssuedHistory  AssetAssignmentHistory[] @relation("AssetAssigner")
  licenseAllocations  LicenseAllocation[]

  @@map("users")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  managerId String?  @map("manager_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  manager   User?  @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  employees User[] @relation("DepartmentEmployees")

  @@map("departments")
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  sessionTokenHash String   @unique @map("session_token_hash")
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent")
  expiresAt        DateTime @map("expires_at") @db.Timestamptz
  lastActiveAt     DateTime @default(now()) @map("last_active_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ==============================================================================
// SDLC ORCHESTRATOR MODELS
// ==============================================================================

model Project {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  slug          String        @unique
  description   String
  repositoryUrl String?       @map("repository_url")
  defaultBranch String        @default("main") @map("default_branch")
  status        ProjectStatus @default(ACTIVE)
  ownerId       String        @map("owner_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  owner             User                 @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  pipelineRuns      PipelineRun[]
  tasks             TaskItem[]
  requirements      ProjectRequirement[]
  architectureDocs  ArchitectureDoc[]
  githubIntegration GitHubIntegration?

  @@index([ownerId])
  @@index([status])
  @@map("projects")
}

model ProjectRequirement {
  id                 String   @id @default(uuid()) @db.Uuid
  projectId          String   @map("project_id") @db.Uuid
  title              String
  rawContent         String   @map("raw_content")
  userStories        Json?    @map("user_stories")
  acceptanceCriteria Json?    @map("acceptance_criteria")
  version            Int      @default(1)
  isApproved         Boolean  @default(false) @map("is_approved")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_requirements")
}

model ArchitectureDoc {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  title      String
  overview   String
  adrs       Json?
  diagrams   Json?
  version    Int      @default(1)
  isApproved Boolean  @default(false) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("architecture_docs")
}

model PipelineRun {
  id                String         @id @default(uuid()) @db.Uuid
  runNumber         String         @unique @map("run_number")
  projectId         String         @map("project_id") @db.Uuid
  triggerType       String         @default("MANUAL") @map("trigger_type")
  status            PipelineStatus @default(PENDING)
  currentStageIndex Int            @default(1) @map("current_stage_index")
  triggeredById     String?        @map("triggered_by_id") @db.Uuid
  startedAt         DateTime?      @map("started_at") @db.Timestamptz
  completedAt       DateTime?      @map("completed_at") @db.Timestamptz
  durationSeconds   Int?           @map("duration_seconds")
  totalTokensUsed   Int            @default(0) @map("total_tokens_used")
  isSimulated       Boolean        @default(true) @map("is_simulated")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  triggeredBy  User?               @relation("PipelineTriggerer", fields: [triggeredById], references: [id], onDelete: SetNull)
  stages       PipelineStage[]
  approvals    StageApproval[]
  securityScan SecurityScanReport?
  testRun      TestRunReport?
  deployments  DeploymentRecord[]

  @@index([projectId, status])
  @@index([createdAt(sort: Desc)])
  @@map("pipeline_runs")
}

model PipelineStage {
  id              String      @id @default(uuid()) @db.Uuid
  pipelineRunId   String      @map("pipeline_run_id") @db.Uuid
  stageOrder      Int         @map("stage_order")
  name            StageName
  agentRole       AgentRole   @map("agent_role")
  status          StageStatus @default(PENDING)
  inputPayload    Json?       @map("input_payload")
  outputPayload   Json?       @map("output_payload")
  errorMessage    String?     @map("error_message")
  retryCount      Int         @default(0) @map("retry_count")
  maxRetries      Int         @default(3) @map("max_retries")
  timeoutSeconds  Int         @default(300) @map("timeout_seconds")
  startedAt       DateTime?   @map("started_at") @db.Timestamptz
  completedAt     DateTime?   @map("completed_at") @db.Timestamptz
  durationSeconds Int?        @map("duration_seconds")
  isSimulated     Boolean     @default(true) @map("is_simulated")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  pipelineRun PipelineRun     @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
  logs        StageLog[]
  artifacts   StageArtifact[]
  approval    StageApproval?

  @@unique([pipelineRunId, stageOrder])
  @@index([pipelineRunId, status])
  @@map("pipeline_stages")
}

model StageApproval {
  id              String           @id @default(uuid()) @db.Uuid
  pipelineRunId   String           @map("pipeline_run_id") @db.Uuid
  pipelineStageId String?          @unique @map("pipeline_stage_id") @db.Uuid
  gateType        ApprovalGateType @map("gate_type")
  status          ApprovalStatus   @default(PENDING)
  decisionNotes   String?          @map("decision_notes")
  reviewerId      String?          @map("reviewer_id") @db.Uuid
  decidedAt       DateTime?        @map("decided_at") @db.Timestamptz
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz

  pipelineRun   PipelineRun    @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
  pipelineStage PipelineStage? @relation(fields: [pipelineStageId], references: [id], onDelete: Cascade)
  reviewer      User?          @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([pipelineRunId, status])
  @@map("stage_approvals")
}

model StageLog {
  id              String   @id @default(uuid()) @db.Uuid
  pipelineStageId String   @map("pipeline_stage_id") @db.Uuid
  level           String   @default("INFO")
  message         String
  metadata        Json?
  timestamp       DateTime @default(now()) @db.Timestamptz

  pipelineStage PipelineStage @relation(fields: [pipelineStageId], references: [id], onDelete: Cascade)

  @@index([pipelineStageId, timestamp])
  @@map("stage_logs")
}

model StageArtifact {
  id              String   @id @default(uuid()) @db.Uuid
  pipelineStageId String   @map("pipeline_stage_id") @db.Uuid
  name            String
  artifactType    String   @map("artifact_type")
  content         String?
  sizeBytes       Int      @default(0) @map("size_bytes")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  pipelineStage PipelineStage @relation(fields: [pipelineStageId], references: [id], onDelete: Cascade)

  @@index([pipelineStageId])
  @@map("stage_artifacts")
}

model TaskItem {
  id            String       @id @default(uuid()) @db.Uuid
  projectId     String       @map("project_id") @db.Uuid
  title         String
  description   String?
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  stageName     StageName?   @map("stage_name")
  assignedAgent AgentRole?   @map("assigned_agent")
  assigneeId    String?      @map("assignee_id") @db.Uuid
  sprint        String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@map("task_items")
}

model GitHubIntegration {
  id             String    @id @default(uuid()) @db.Uuid
  projectId      String    @unique @map("project_id") @db.Uuid
  repoFullName   String    @map("repo_full_name")
  installationId String?   @map("installation_id")
  encryptedToken String?   @map("encrypted_token")
  webhookSecret  String?   @map("webhook_secret")
  lastSyncAt     DateTime? @map("last_sync_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("github_integrations")
}

model SecurityScanReport {
  id            String   @id @default(uuid()) @db.Uuid
  pipelineRunId String   @unique @map("pipeline_run_id") @db.Uuid
  criticalCount Int      @default(0) @map("critical_count")
  highCount     Int      @default(0) @map("high_count")
  mediumCount   Int      @default(0) @map("medium_count")
  lowCount      Int      @default(0) @map("low_count")
  findings      Json?
  passed        Boolean  @default(true)
  scannedAt     DateTime @default(now()) @map("scanned_at") @db.Timestamptz

  pipelineRun PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@map("security_scan_reports")
}

model TestRunReport {
  id              String   @id @default(uuid()) @db.Uuid
  pipelineRunId   String   @unique @map("pipeline_run_id") @db.Uuid
  totalTests      Int      @default(0) @map("total_tests")
  passedCount     Int      @default(0) @map("passed_count")
  failedCount     Int      @default(0) @map("failed_count")
  skippedCount    Int      @default(0) @map("skipped_count")
  coveragePercent Float    @default(0.0) @map("coverage_percent")
  durationMs      Int      @default(0) @map("duration_ms")
  testSuites      Json?    @map("test_suites")
  passed          Boolean  @default(true)
  executedAt      DateTime @default(now()) @map("executed_at") @db.Timestamptz

  pipelineRun PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@map("test_run_reports")
}

model DeploymentRecord {
  id            String          @id @default(uuid()) @db.Uuid
  pipelineRunId String          @map("pipeline_run_id") @db.Uuid
  environment   EnvironmentType
  commitSha     String          @map("commit_sha")
  releaseTag    String?         @map("release_tag")
  status        String
  deploymentUrl String?         @map("deployment_url")
  deployLogs    String?         @map("deploy_logs")
  deployedAt    DateTime        @default(now()) @map("deployed_at") @db.Timestamptz

  pipelineRun PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@index([pipelineRunId, environment])
  @@map("deployment_records")
}

model AgentConfig {
  id            String    @id @default(uuid()) @db.Uuid
  role          AgentRole @unique
  name          String
  description   String
  modelProvider String    @default("deterministic-simulated") @map("model_provider")
  systemPrompt  String    @map("system_prompt")
  temperature   Float     @default(0.2)
  maxTokens     Int       @default(4096) @map("max_tokens")
  version       Int       @default(1)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("agent_configs")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ==============================================================================
// LEGACY ITSM MODELS (Preserved for backwards compatibility)
// ==============================================================================

model Ticket {
  id           String         @id @default(uuid()) @db.Uuid
  ticketNumber String         @unique @map("ticket_number")
  title        String
  description  String
  category     TicketCategory
  priority     TicketPriority
  status       TicketStatus   @default(NEW)
  creatorId    String         @map("creator_id") @db.Uuid
  assigneeId   String?        @map("assignee_id") @db.Uuid
  assetId      String?        @map("asset_id") @db.Uuid
  slaDueAt     DateTime       @map("sla_due_at") @db.Timestamptz
  resolvedAt   DateTime?      @map("resolved_at") @db.Timestamptz
  closedAt     DateTime?      @map("closed_at") @db.Timestamptz
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  creator  User            @relation("TicketCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  asset    Asset?          @relation("TicketAsset", fields: [assetId], references: [id], onDelete: SetNull)
  comments TicketComment[]
  history  TicketHistory[]

  @@index([status, assigneeId])
  @@index([status, slaDueAt])
  @@index([creatorId, createdAt])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  content    String
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

model TicketHistory {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  actorId      String   @map("actor_id") @db.Uuid
  fieldChanged String   @map("field_changed")
  oldValue     String?  @map("old_value")
  newValue     String?  @map("new_value")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("ticket_history")
}

model Asset {
  id                String        @id @default(uuid()) @db.Uuid
  assetTag          String        @unique @map("asset_tag")
  serialNumber      String        @unique @map("serial_number")
  name              String
  category          AssetCategory
  model             String
  manufacturer      String
  status            AssetStatus   @default(IN_STOCK)
  assignedToUserId  String?       @map("assigned_to_user_id") @db.Uuid
  purchaseDate      DateTime?     @map("purchase_date") @db.Date
  purchaseCost      Decimal?      @map("purchase_cost") @db.Decimal(12, 2)
  warrantyExpiresAt DateTime?     @map("warranty_expires_at") @db.Date
  notes             String?
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  assignedToUser     User?                    @relation("UserAssignedAssets", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignmentHistory  AssetAssignmentHistory[]
  tickets            Ticket[]                 @relation("TicketAsset")
  licenseAllocations LicenseAllocation[]

  @@index([status, category])
  @@map("assets")
}

model AssetAssignmentHistory {
  id                String    @id @default(uuid()) @db.Uuid
  assetId           String    @map("asset_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  assignedById      String    @map("assigned_by_id") @db.Uuid
  assignedAt        DateTime  @default(now()) @map("assigned_at") @db.Timestamptz
  returnedAt        DateTime? @map("returned_at") @db.Timestamptz
  conditionAtReturn String?   @map("condition_at_return")
  notes             String?

  asset      Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user       User  @relation("AssetCustodian", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy User  @relation("AssetAssigner", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([assetId])
  @@index([userId])
  @@map("asset_assignment_history")
}

model SoftwareLicense {
  id             String      @id @default(uuid()) @db.Uuid
  name           String
  vendor         String
  licenseType    LicenseType @map("license_type")
  totalSeats     Int         @map("total_seats")
  allocatedSeats Int         @default(0) @map("allocated_seats")
  expiresAt      DateTime?   @map("expires_at") @db.Date
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  allocations LicenseAllocation[]

  @@map("software_licenses")
}

model LicenseAllocation {
  id          String    @id @default(uuid()) @db.Uuid
  licenseId   String    @map("license_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  assetId     String?   @map("asset_id") @db.Uuid
  allocatedAt DateTime  @default(now()) @map("allocated_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz

  license SoftwareLicense @relation(fields: [licenseId], references: [id], onDelete: Restrict)
  user    User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  asset   Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([licenseId])
  @@index([userId])
  @@map("license_allocations")
}
