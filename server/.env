# ==============================================================================
# NEXDESK - Environment Configuration Template
# Copy this file to '.env' in local development. Never commit '.env' to git.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Database Connections (PostgreSQL via Supabase or Local Docker)
# ------------------------------------------------------------------------------
# 1. DATABASE_URL:
#    - For Supabase (Production / Cloud Dev): Use the Transaction Mode Pooler (Port 6543)
#      e.g. "postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#    - For Local Docker PostgreSQL:
#      e.g. "postgresql://nexdesk_user:nexdesk_dev_password@localhost:5432/nexdesk_dev?schema=public"
DATABASE_URL="postgresql://postgres.txvvfvztdqjhkfbtlbfg:Nexdesk%40709@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL:
#    - For Supabase: Use Direct Connection (Port 5432) for running Prisma migrations
#      e.g. "postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"
#    - For Local Docker: Same as DATABASE_URL
DIRECT_URL="postgresql://postgres.txvvfvztdqjhkfbtlbfg:Nexdesk%40709@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# Session & Authentication Security
# ------------------------------------------------------------------------------
# Generate a secure 64-char random string in production (e.g. openssl rand -hex 32)
SESSION_SECRET="dev_insecure_session_secret_replace_in_production_min_32_chars"
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Logging & Diagnostic Telemetry
# ------------------------------------------------------------------------------
# Options: fatal, error, warn, info, debug, trace
LOG_LEVEL=debug

# Supabase Integration
SUPABASE_URL="https://txvvfvztdqjhkfbtlbfg.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_Mb0oiTGB5QfCsqHiHpvoMg_wmoPOkKB"
